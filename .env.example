# Wallet-copy-only Polymarket agent configuration.
#
# Paper/research runs do not require live credentials. Live execution is only
# admitted through src/wallet_copy/execution.py with explicit operator approval.

# Polymarket CLOB endpoint.
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Live execution credentials. Leave blank for paper-only operation.
PRIVATE_KEY=
POLYMARKET_PROXY=

# Optional builder/relayer credentials if the execution stack needs them.
BUILDER_API_KEY=
BUILDER_SECRET=
BUILDER_PASSPHRASE=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# Live position/accounting cache written by TradeExecutor.
POSITIONS_PATH=data/wallet_copy_live_positions.json

# Local pre-submit capital guard for live BUY orders.
LIVE_CAPITAL_GUARD_ENABLED=true
LIVE_CAPITAL_MIN_BUFFER_USD=0.0
WALLET_COPY_INVENTORY_MIN_AVAILABLE_BALANCE_USD=0.0

# Optional low-level transport controls used by ingestion/research code.
POLYMARKET_API_TIMEOUT_SECONDS=30
POLYMARKET_MAX_RETRIES=3

# Operator-provisioned realtime evidence routes.
# Public Polygon endpoints have been measured as non-admissible for the
# wallet-copy burn-in path from this host: publicnode WSS connects but has not
# emitted target wallet fills, and public HTTP getLogs returns 403. Set these
# to credentialed Alchemy/QuickNode-class Polygon endpoints before expecting
# reliable OrderFilled fallback evidence.
POLYGON_RPC_URL=
POLYGON_WSS_URL=

# Optional operator-provisioned egress proxy/VPS route for direct Polymarket
# RTDS, Data API, Gamma, and CLOB traffic when the local host receives
# TCP/TLS-level resets from polymarket.com or ws-live-data.polymarket.com.
POLYMARKET_EGRESS_PROXY_URL=
